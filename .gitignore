# Scenario artifacts. Everything a run produces is regenerated by run.sh; only
# the projected `expected/*.json` is committed, and it is written by
# `make update-expected` and reviewed like code.
*.db
*.db-shm
*.db-wal
tuning.jsonl
tuning.jsonl.manifest.md
/out/
/kno-demo/

# A locally installed kno, so the tests can run against a real binary without
# it landing in a commit.
/.local-kno
/bin/

# Go
*.test
*.out
